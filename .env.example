# Bunana V2 环境变量
# 复制此文件为 .env.local 并填入实际值

# ===== 智谱 GLM 视觉模型 =====
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4v-flash

# ===== Dify 回退 =====
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=

# ===== Supabase（仅节点 F 需要） =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== CORS =====
BUNANA_ALLOWED_ORIGIN=http://localhost:3000

# ===== 安全: API 共享密钥 =====
# 服务端验证用（非 NEXT_PUBLIC，不暴露到客户端）
BUNANA_API_SECRET=
# 客户端请求用（NEXT_PUBLIC，会打包到 JS bundle）
NEXT_PUBLIC_BUNANA_API_SECRET=
